# HTTPS for the platform's public API (docs/platform.md §10.1): Caddy with Let's Encrypt, from 80
# to 443, in front of platform:24680 (the internal API, :24681, does not go through here). The
# variables come from the compose file (staging.env / production.env).
#
# No access log (§10.1 and §11.1): there is no "log" directive on the site, so Caddy writes no
# per-request line; only its warnings and errors, which go to journald with the rest.
{
	email {$ELDMARK_ACME_EMAIL}
}

{$ELDMARK_DOMAIN} {
	# The platform reads the client IP only from X-Real-IP and only from ELDMARK_TRUSTED_PROXIES (this
	# container's fixed IP on the edge network); header_up always overwrites it, so an X-Real-IP sent by
	# the client does not get through.
	reverse_proxy platform:24680 {
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}
