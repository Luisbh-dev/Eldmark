class_name CombatSoundBank
extends RefCounted
## Combat and footstep sound banks (ART-11, client only): each group is a folder of
## [code]assets/audio/sfx/[/code] with between 3 and 8 variants, its volume trim (the one from
## [code]niveles.json[/code], which balances the categories against each other) and the random pitch and volume variation.
## A group is loaded the first time it is requested and returns an [AudioStreamRandomizer] that does not repeat the
## last sound.
## [br][br]
## [b]What plays for each thing.[/b] [method impact_group] picks the group of an impact according to the material
## ([enum Armor]) and whether it is a block or a parry; [method step_group] that of a footstep according to the surface
## ([constant SURFACE_GRASS]...). The in-house sounds are generated by [code]tools/audio/synth_sfx.py[/code] and the
## grass and wood footsteps are from Kenney Impact Sounds (CC0, see [code]assets/LICENSES.md[/code]); the listening
## sheet from [code]tools/audio/listening_sheet.py[/code] shows each category with its alternatives.

## Material of whatever receives the hit.
enum Armor { FLESH, LEATHER, GAMBESON, MAIL, SHIELD_WOOD, SHIELD_METAL, HOLLOW }

const SURFACE_GRASS: StringName = &"grass"
const SURFACE_DIRT: StringName = &"dirt"
const SURFACE_STONE: StringName = &"stone"
const SURFACE_WOOD: StringName = &"wood"
const SURFACE_WATER: StringName = &"water"
const SURFACES: Array[StringName] = [SURFACE_GRASS, SURFACE_DIRT, SURFACE_STONE, SURFACE_WOOD, SURFACE_WATER]

const SFX_DIR: String = "res://assets/audio/sfx"

## Groups: name -> [folder, prefix, number of variants, volume trim (dB), pitch variation (0.05 =
## ±5 %), volume variation (dB)]. The numbers are those of [code]niveles.json[/code]; a test checks that
## they match.
const GROUPS: Dictionary = {
	&"sword_swing_light": ["swing", "sword_swing_light", 6, -5.0, 0.05, 2.0],
	&"sword_swing_heavy": ["swing", "sword_swing_heavy", 3, -4.0, 0.05, 2.0],
	&"hit_flesh": ["hit_flesh", "hit_flesh", 5, 0.0, 0.05, 2.0],
	&"hit_leather": ["hit_leather", "hit_leather", 5, 0.0, 0.05, 2.0],
	&"hit_gambeson": ["hit_gambeson", "hit_gambeson", 5, 0.0, 0.05, 2.0],
	&"hit_mail": ["hit_mail", "hit_mail", 4, 0.0, 0.05, 2.0],
	&"hit_shield_wood": ["hit_shield", "hit_shield_wood", 5, -1.0, 0.05, 2.0],
	&"hit_shield_metal": ["hit_shield", "hit_shield_metal", 3, -1.0, 0.05, 2.0],
	&"clash_metal": ["parry", "clash_metal", 4, -2.0, 0.04, 2.0],
	&"body_fall": ["body", "body_fall", 3, -3.0, 0.05, 2.0],
	&"dodge_roll": ["dodge", "dodge_roll", 3, -9.0, 0.06, 2.0],
	&"dodge_step": ["dodge", "dodge_step", 2, -9.0, 0.06, 2.0],
	&"step_stone": ["step_stone", "step_stone", 8, -11.0, 0.05, 2.0],
	&"step_dirt": ["step_dirt", "step_dirt", 8, -12.0, 0.05, 2.0],
	&"step_grass": ["step_grass", "step_grass", 5, -14.0, 0.05, 2.0],
	&"step_wood": ["step_wood", "step_wood", 5, -14.0, 0.05, 2.0],
	&"hollow_hurt": ["hollow", "hollow_hurt", 4, -4.0, 0.06, 2.0],
	&"hollow_death": ["hollow", "hollow_death", 2, -3.0, 0.05, 2.0],
}

# Group -> {stream: AudioStreamRandomizer, volume_db: float}.
static var _cache: Dictionary = {}


## true if [param group] exists in the table.
static func has_group(group: StringName) -> bool:
	return GROUPS.has(group)


## Names of the files of [param group] ([code]res://[/code] paths, the ones that exist).
static func files_of(group: StringName) -> PackedStringArray:
	var files: PackedStringArray = PackedStringArray()
	if not GROUPS.has(group):
		return files
	var entry: Array = GROUPS[group]
	for index: int in range(1, int(entry[2]) + 1):
		files.append("%s/%s/%s_%02d.ogg" % [SFX_DIR, entry[0], entry[1], index])
	return files


## Volume trim (dB) of the group (0 if it does not exist).
static func volume_db_of(group: StringName) -> float:
	return float((GROUPS[group] as Array)[3]) if GROUPS.has(group) else 0.0


## The group's sound with its pitch and volume variation, or null if there is no loadable file (the game keeps going
## without sound instead of breaking).
static func stream_of(group: StringName) -> AudioStream:
	var loaded: Dictionary = _load(group)
	return loaded.get("stream") as AudioStream


## Group of an impact on [param material]; with [param blocked] the hit was received by a shield (wood, or metal if
## the blocker has the metal rim) and with [param parried] the steel clash plays.
static func impact_group(material: Armor, blocked: bool = false, parried: bool = false) -> StringName:
	if parried:
		return &"clash_metal"
	if blocked:
		return &"hit_shield_metal" if material == Armor.SHIELD_METAL else &"hit_shield_wood"
	match material:
		Armor.LEATHER:
			return &"hit_leather"
		Armor.GAMBESON:
			return &"hit_gambeson"
		Armor.MAIL:
			return &"hit_mail"
		Armor.SHIELD_WOOD:
			return &"hit_shield_wood"
		Armor.SHIELD_METAL:
			return &"hit_shield_metal"
	return &"hit_flesh"


## Group of a footstep on surface [param surface] (the ford water sounds like wet earth: the same group with
## another pitch, see [method step_pitch]).
static func step_group(surface: StringName) -> StringName:
	match surface:
		SURFACE_STONE:
			return &"step_stone"
		SURFACE_WOOD:
			return &"step_wood"
		SURFACE_DIRT, SURFACE_WATER:
			return &"step_dirt"
	return &"step_grass"


## Pitch a footstep on [param surface] is played with: water lowers the earth one so that it sounds like splashing.
static func step_pitch(surface: StringName) -> float:
	return 0.72 if surface == SURFACE_WATER else 1.0


## Forgets what was loaded (the tests).
static func clear_cache() -> void:
	_cache.clear()


static func _load(group: StringName) -> Dictionary:
	if _cache.has(group):
		return _cache[group]
	var result: Dictionary = {}
	if GROUPS.has(group):
		var streams: Array[AudioStream] = []
		for path: String in files_of(group):
			if ResourceLoader.exists(path):
				var stream: AudioStream = load(path) as AudioStream
				if stream != null:
					streams.append(stream)
		if not streams.is_empty():
			var entry: Array = GROUPS[group]
			var randomizer: AudioStreamRandomizer = AudioDirector.make_variation(streams,
					float(entry[4]), float(entry[5]))
			result = {"stream": randomizer, "volume_db": float(entry[3])}
	_cache[group] = result
	return result
