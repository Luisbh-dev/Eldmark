[sub_resource type="Shader" id="Shader_checker"]
code = "shader_type spatial;
// Suelo a cuadros de 1 m en coordenadas de mundo: sirve para ver si los pies patinan.
uniform vec3 color_a : source_color = vec3(0.56, 0.56, 0.52);
uniform vec3 color_b : source_color = vec3(0.36, 0.38, 0.34);
uniform float cell_size = 1.0;
varying vec3 world_position;

void vertex() {
	world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 cell = floor(world_position.xz / cell_size);
	float checker = mod(cell.x + cell.y, 2.0);
	ALBEDO = mix(color_a, color_b, checker);
	ROUGHNESS = 0.9;
}
"

