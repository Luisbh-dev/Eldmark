# Godot 4
.godot/
/android/

# Builds y exportaciones
/build/
/exports/

# Paquetes originales de assets (se guardan fuera del repo, en ../Eldmark-raw)
*.zip
*.7z
*.blend1

# Demos de los addons
addons/*/demo/

# Configuración local
.env
CLAUDE.local.md

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Ajustes locales de Godot de cada máquina
override.cfg
.claude/worktrees/

# Copias temporales de las librerías de GDExtension que crea el editor en Windows
addons/*/bin/~*

# Ajustes locales de Claude Code (permisos de esta máquina)
.claude/settings.local.json

# Secretos (plataforma.md §10.3): nunca entran en git; sí los ejemplos y los PEM de prueba
*.env
!*.env.example
platform/deploy/secrets/
*.pem
*.key
!tests/fixtures/**/*.pem

# Binario de la plataforma compilado dentro de platform/
/platform/eldmark-platform
/platform/eldmark-platform.exe

# Caches de Python (herramientas de assets)
__pycache__/
*.pyc
