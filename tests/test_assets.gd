extends TestCase
## Asset validator (ART-05, only the automatic part; the stress scene belongs to TEC-21).
## [br][br]
## Fails if the repository contains:
## [br]- a [code].scn[/code] or a [code].res[/code] that is not a Terrain3D region
## ([code]scenes/world/zones/<zone>/terrain/*.res[/code]): scenes and resources go as text;
## [br]- a texture larger than [constant MAX_TEXTURE_SIZE] px anywhere;
## [br]- a folder in [code]assets/models[/code], [code]assets/animations[/code] or
## [code]assets/textures[/code] with files and no entry in [code]assets/LICENCIAS.md[/code];
## [br]- a character scene whose collision capsule is not 1.8 m tall.
## [br][br]
## Addons ([code]addons/[/code]) are third-party and are not examined. If an already existing asset
## broke a rule, it is not deleted: it is noted in the list of known exceptions below,
## with the reason.

## Maximum side (px) of a texture.
const MAX_TEXTURE_SIZE: int = 2048
## Height (m) of the character's collision capsule.
const CAPSULE_HEIGHT: float = 1.8
const CHARACTER_SCENE: String = "res://scenes/characters/player_character.tscn"
const LICENSES_FILE: String = "res://assets/LICENCIAS.md"
## Folders that are walked to look for [code].scn[/code] and [code].res[/code] (the project
## root minus these).
const SKIPPED_DIRS: Array[String] = ["addons", "build", "exports"]
## Roots whose subfolders each hold a pack and must be in LICENCIAS.md.
const PACK_ROOTS: Array[String] = [
	"res://assets/models", "res://assets/animations", "res://assets/textures",
]
## Folders where textures are looked for.
const TEXTURE_ROOTS: Array[String] = ["res://assets", "res://scenes"]
const TEXTURE_EXTENSIONS: Array[String] = [
	"png", "jpg", "jpeg", "webp", "tga", "bmp", "exr", "hdr",
]
## Files that do not count as pack content (generated by or accompanying Godot).
const IGNORED_EXTENSIONS: Array[String] = ["uid", "import"]

# --- Known exceptions -------------------------------------------------------------------
# Today none: all assets comply with the rules. If one that does not ever comes in, it is noted here
# with a line giving the reason (res:// path -> reason) instead of deleting it.

## .scn or .res allowed even though they are not a Terrain3D region.
const KNOWN_BINARY_EXCEPTIONS: Dictionary = {}
## Textures larger than MAX_TEXTURE_SIZE px allowed.
const KNOWN_OVERSIZED_TEXTURES: Dictionary = {}
## Folders with files not listed in LICENCIAS.md (path without res:// or trailing slash).
const KNOWN_UNLISTED_FOLDERS: Dictionary = {}


# --- Binaries (.scn / .res) ------------------------------------------------------------------

func test_no_binary_scenes_or_resources_except_terrain_regions() -> void:
	var offenders: Array[String] = []
	var scanned: int = 0
	var binaries_seen: int = 0
	for path: String in _collect_files("res://", SKIPPED_DIRS):
		scanned += 1
		var extension: String = path.get_extension().to_lower()
		if extension != "scn" and extension != "res":
			continue
		binaries_seen += 1
		if is_terrain_region(path) or KNOWN_BINARY_EXCEPTIONS.has(path):
			continue
		offenders.append(path)
	# That the walk really sees the project (and reaches the Terrain3D regions).
	assert_true(scanned > 100 and binaries_seen > 0,
			"the project is walked (%d files, %d binaries)" % [scanned, binaries_seen])
	assert_true(offenders.is_empty(),
			"Scenes and resources go as text (.tscn/.tres); only the .res files of the "
			+ "Terrain3D regions are accepted (scenes/world/zones/*/terrain/*.res). Extra ones: %s" % [offenders])


func test_terrain_region_rule() -> void:
	# The rule itself: only scenes/world/zones/<zone>/terrain/<file>.res.
	assert_true(is_terrain_region("res://scenes/world/zones/vado_gris/terrain/terrain3d_00_00.res"),
			"a Vado Gris region")
	assert_true(is_terrain_region("res://scenes/world/zones/eldrun/terrain/x.res"), "another zone")
	assert_false(is_terrain_region("res://scenes/world/zones/vado_gris/terrain/x.scn"),
			"a .scn never")
	assert_false(is_terrain_region("res://scenes/world/zones/vado_gris/x.res"), "outside terrain/")
	assert_false(is_terrain_region("res://scenes/world/zones/vado_gris/terrain/sub/x.res"),
			"in a subfolder of terrain/")
	assert_false(is_terrain_region("res://assets/models/x.res"), "in assets/")
	assert_false(is_terrain_region("res://scenes/world/zones/terrain/x.res"), "no zone")
	assert_false(is_terrain_region("res://x.res"), "at the root")
	# And real regions exist, so the previous test does not pass by seeing nothing.
	var regions: int = 0
	for path: String in _collect_files("res://scenes/world/zones", []):
		if is_terrain_region(path):
			regions += 1
	assert_true(regions > 0, "Vado Gris has Terrain3D regions")


# --- Textures ---------------------------------------------------------------------------------

func test_textures_are_at_most_2048_px() -> void:
	var checked: int = 0
	var offenders: Array[String] = []
	for root: String in TEXTURE_ROOTS:
		for path: String in _collect_files(root, SKIPPED_DIRS):
			if not TEXTURE_EXTENSIONS.has(path.get_extension().to_lower()):
				continue
			if KNOWN_OVERSIZED_TEXTURES.has(path):
				continue
			var size: Vector2i = image_size(path)
			checked += 1
			if size.x < 0:
				offenders.append("%s (no se pudo leer)" % path)
			elif size.x > MAX_TEXTURE_SIZE or size.y > MAX_TEXTURE_SIZE:
				offenders.append("%s (%d x %d)" % [path, size.x, size.y])
	assert_true(checked > 0, "textures to check have been found")
	assert_true(offenders.is_empty(),
			"Textures larger than %d px (they are shrunk before entering, see LICENCIAS.md): %s" % [
			MAX_TEXTURE_SIZE, offenders])


func test_image_size_reader() -> void:
	# The reader has to read the sizes correctly, or the previous test would be worthless.
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://build"))
	var cases: Array[Vector2i] = [Vector2i(4, 3), Vector2i(2048, 1), Vector2i(1, 2049)]
	for size: Vector2i in cases:
		var path: String = "res://build/test_assets_%dx%d.png" % [size.x, size.y]
		var image: Image = Image.create(size.x, size.y, false, Image.FORMAT_RGBA8)
		if not assert_eq(image.save_png(path), OK, "%s is saved" % path):
			continue
		assert_eq(image_size(path), size, "size of %s" % path)
		DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	assert_eq(image_size("res://build/no_existe.png"), Vector2i(-1, -1), "a file that does not exist")
	# And with the repo's real textures it gives sizes, not errors.
	var unreadable: Array[String] = []
	var read: int = 0
	for path: String in _collect_files("res://assets", []):
		if path.get_extension().to_lower() == "png":
			read += 1
			if image_size(path).x <= 0:
				unreadable.append(path)
	assert_true(read > 0 and unreadable.is_empty(),
			"the PNGs in assets/ are read (%d; not read: %s)" % [read, unreadable])


# --- Pack folders and LICENCIAS.md ----------------------------------------------------------

func test_every_pack_folder_has_a_license_entry() -> void:
	var listed: Array[String] = listed_paths(FileAccess.get_file_as_string(LICENSES_FILE))
	if not assert_false(listed.is_empty(), "LICENCIAS.md lists asset folders"):
		return
	var checked: int = 0
	var offenders: Array[String] = []
	for root: String in PACK_ROOTS:
		for directory: String in _collect_folders_with_files(root):
			var relative: String = directory.trim_prefix("res://")
			checked += 1
			if is_covered(relative, listed) or KNOWN_UNLISTED_FOLDERS.has(relative):
				continue
			offenders.append(relative)
	assert_true(checked > 0, "pack folders to check have been found")
	assert_true(offenders.is_empty(),
			"Asset folders with no entry in assets/LICENCIAS.md (note author, version, date, "
			+ "URL and license of the pack): %s" % [offenders])


func test_license_coverage_rule() -> void:
	var text: String = "\n".join([
		"| Carpeta en el repo | `assets/animations/ual1/` (y `assets/animations/rig/mapa.tres`) |",
		"| Carpeta en el repo | `assets/models/environment/village/` (`meshes/*.tres` extraídas) |",
		"- Materiales `assets/models/characters/**/materials/*.tres` y `assets/materials/{a,b}/`.",
		"- `assets/models/environment/custom/puente.tres` (malla propia).",
		"Texto con `ruta/que/no/es/de/assets` y `docs/otra.md`.",
	])
	var listed: Array[String] = listed_paths(text)
	assert_eq(listed, [
		"assets/animations/ual1", "assets/animations/rig", "assets/models/environment/village",
		"assets/models/environment/custom",
	] as Array[String], "folder paths extracted from the text (no wildcards or loose files)")
	assert_true(is_covered("assets/animations/ual1", listed), "the folder itself")
	assert_true(is_covered("assets/models/environment/village/meshes", listed), "a subfolder")
	assert_true(is_covered("assets/animations/rig", listed), "the folder of a listed file")
	assert_true(is_covered("assets/models/environment/custom", listed), "ditto")
	assert_false(is_covered("assets/animations/ual3", listed), "another folder at the same level")
	assert_false(is_covered("assets/animations/ual1x", listed), "a text prefix does not count")
	assert_false(is_covered("assets/models/characters/base", listed),
			"wildcards give no coverage")
	assert_false(is_covered("assets/animations", listed), "the parent folder is not enough")


# --- Character scene ----------------------------------------------------------------------

func test_character_scene_has_a_1_8_m_capsule() -> void:
	var scene: PackedScene = load(CHARACTER_SCENE) as PackedScene
	if not assert_not_null(scene, "%s loads" % CHARACTER_SCENE):
		return
	var character: Node = scene.instantiate()
	var collision: CollisionShape3D = character.get_node_or_null("Collision") as CollisionShape3D
	if assert_not_null(collision, "the character has a Collision node"):
		var capsule: CapsuleShape3D = collision.shape as CapsuleShape3D
		if assert_not_null(capsule, "and its shape is a capsule"):
			assert_near(capsule.height, CAPSULE_HEIGHT, 1e-4, "the capsule is 1.8 m tall")
			assert_true(capsule.radius > 0.0 and capsule.radius * 2.0 <= capsule.height,
					"with a reasonable radius (%s)" % capsule.radius)
			# Feet at the origin: the whole capsule above the character's ground.
			assert_near(collision.position.y - capsule.height * 0.5, 0.0, 1e-4,
					"the capsule's bottom edge is at y = 0")
	character.free()


# --- Utilities -------------------------------------------------------------------------------

## true if [param path] is a Terrain3D region: a [code].res[/code] directly inside
## [code]scenes/world/zones/<zone>/terrain/[/code].
static func is_terrain_region(path: String) -> bool:
	if path.get_extension().to_lower() != "res":
		return false
	var parts: PackedStringArray = path.trim_prefix("res://").split("/")
	return parts.size() == 6 and parts[0] == "scenes" and parts[1] == "world" \
			and parts[2] == "zones" and parts[4] == "terrain"


## Folder paths (without [code]res://[/code] or trailing slash) that [param markdown] cites in
## code quotes and that start with [code]assets/[/code]. For a file, its folder is taken; paths
## with wildcards ([code]*[/code], [code]{[/code]) are discarded because they do not say which concrete
## folder they cover.
static func listed_paths(markdown: String) -> Array[String]:
	var result: Array[String] = []
	var regex := RegEx.new()
	regex.compile("`([^`\n]+)`")
	for found: RegExMatch in regex.search_all(markdown):
		var entry: String = found.get_string(1).strip_edges().trim_suffix("/")
		if not entry.begins_with("assets/") or entry.contains("*") or entry.contains("{"):
			continue
		if entry.get_extension() != "":
			entry = entry.get_base_dir()
		if not result.has(entry):
			result.append(entry)
	return result


## true if the folder [param directory] (without [code]res://[/code]) is one of those in [param listed] or
## is inside one.
static func is_covered(directory: String, listed: Array[String]) -> bool:
	for entry: String in listed:
		if directory == entry or directory.begins_with(entry + "/"):
			return true
	return false


## Size in pixels of the image file [param path], or (-1, -1) if it cannot be read. PNGs are
## read from their header (fast, without decoding); the rest, with [method Image.load_from_file].
static func image_size(path: String) -> Vector2i:
	if path.get_extension().to_lower() == "png":
		var file: FileAccess = FileAccess.open(path, FileAccess.READ)
		if file == null:
			return Vector2i(-1, -1)
		var header: PackedByteArray = file.get_buffer(24)
		if header.size() == 24 and header.slice(1, 4).get_string_from_ascii() == "PNG":
			# After the signature (8 B) and the size and type of the IHDR chunk (8 B), the width and
			# the height, 4 B each and in network order.
			return Vector2i(_big_endian_u32(header, 16), _big_endian_u32(header, 20))
	var image: Image = Image.load_from_file(path)
	if image == null or image.is_empty():
		return Vector2i(-1, -1)
	return image.get_size()


static func _big_endian_u32(bytes: PackedByteArray, offset: int) -> int:
	return (bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) \
			| bytes[offset + 3]


## All the files under [param root] ([code]res://[/code] paths), without entering hidden folders
## or those in [param skipped] (names, only at the level of [param root]).
static func _collect_files(root: String, skipped: Array[String]) -> Array[String]:
	var files: Array[String] = []
	var folders: Array[String] = []
	_walk(root, skipped, files, folders, true)
	return files


## Folders under [param root] that have files of their own (not counting [code].uid[/code] or
## [code].import[/code] files).
static func _collect_folders_with_files(root: String) -> Array[String]:
	var files: Array[String] = []
	var folders: Array[String] = []
	_walk(root, [], files, folders, true)
	return folders


static func _walk(directory: String, skipped: Array[String], files: Array[String],
		folders: Array[String], is_top: bool) -> void:
	var own_files: int = 0
	for file_name: String in DirAccess.get_files_at(directory):
		# "Hidden" is the dot-prefixed name (.gitkeep, .godot/), the same on every system:
		# DirAccess only hides those on Linux, and on Windows lets them through (they do not carry the
		# hidden attribute), so the editor cache and the .gitkeep files were being counted.
		if file_name.begins_with("."):
			continue
		files.append(directory.path_join(file_name))
		if not IGNORED_EXTENSIONS.has(file_name.get_extension().to_lower()):
			own_files += 1
	if own_files > 0:
		folders.append(directory)
	for sub_name: String in DirAccess.get_directories_at(directory):
		if sub_name.begins_with(".") or (is_top and skipped.has(sub_name)):
			continue
		_walk(directory.path_join(sub_name), skipped, files, folders, false)
