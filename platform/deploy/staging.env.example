# Variables del compose de staging (docs/plataforma.md §12): copia este archivo a staging.env, que git
# ignora, rellénalo y úsalo con «docker compose --env-file staging.env …» (cabecera de docker-compose.yml).
# Aquí no va ningún secreto: cada uno es un archivo de ELDMARK_SECRETS_DIR (§10.3), y la CI falla si un
# *.example trae el valor de uno (tools/check_secrets.sh).
ELDMARK_ENV=staging

# Dominio de la API pública (Caddy pide su certificado a Let's Encrypt) y el correo de la cuenta ACME.
ELDMARK_DOMAIN=staging.eldmark.example
ELDMARK_ACME_EMAIL=ops@eldmark.example

# Imágenes (staging desde main, GHCR). Sin ellas, el compose las construye en local (eldmark-*:local); la de
# las zonas es de TEC-20.
ELDMARK_PLATFORM_IMAGE=ghcr.io/luisbh-dev/eldmark-platform:main
ELDMARK_OPS_IMAGE=ghcr.io/luisbh-dev/eldmark-ops:main
ELDMARK_ZONE_IMAGE=ghcr.io/luisbh-dev/eldmark-zone:main

# Host al que conectan los clientes por UDP (el --public-address de las zonas) y los que admite el
# registro de una zona (ELDMARK_ZONE_HOSTS, separados por comas).
ELDMARK_PUBLIC_HOST=staging.eldmark.example
ELDMARK_ZONE_HOSTS=staging.eldmark.example

# Protocolo mínimo del cliente (por debajo, 426): obligatorio fuera de dev y test.
ELDMARK_MIN_PROTOCOL=7

# Remitente de los correos (el proveedor SMTP va en el secreto smtp_url; pendiente del usuario).
ELDMARK_MAIL_FROM=no-reply@eldmark.example

# Reinos abiertos y zona de entrada de cada uno (§2.3; estos son los valores por defecto).
ELDMARK_OPEN_REALMS=vardheim,solmarch
ELDMARK_ENTRY_ZONES=vardheim=vado_gris,solmarch=vado_gris

# Carpeta de los secretos (relativa a este directorio o absoluta) y de las copias en el VPS.
ELDMARK_SECRETS_DIR=./secrets
ELDMARK_BACKUP_HOST_DIR=/var/backups/eldmark-staging

# WAL a S3 compatible con WAL-G (pitr_check.sh prueba el procedimiento): imagen de la base con wal-g
# y sus credenciales; mientras no esté, off.
ELDMARK_PG_ARCHIVE_MODE=off
#ELDMARK_DB_IMAGE=ghcr.io/luisbh-dev/eldmark-db-walg:16
#ELDMARK_PG_ARCHIVE_COMMAND=wal-g wal-push %p

# Red de Caddy y su IP fija (la única desde la que la plataforma lee X-Real-IP). Cámbialas solo si
# chocan con otra red del VPS.
ELDMARK_EDGE_SUBNET=172.30.0.0/24
ELDMARK_CADDY_IP=172.30.0.2
