[ext_resource type="Resource" path="res://data/combat/shield_wall.tres" id="11_wall"]

[resource]
script = ExtResource("1_weapon")
id = &"sword_shield"
light_combo = Array[ExtResource("2_attack")]([ExtResource("3_light1"), ExtResource("4_light2"), ExtResource("5_light3")])
heavy_attack = ExtResource("6_heavy")
block_angle_deg = 120.0
block_mitigation = 1.0
block_move_scale = 0.5
block_turn_rate = 8.0
block_stamina_per_damage = 1.0
dodge = ExtResource("7_dodge")
abilities = Array[ExtResource("8_ability")]([ExtResource("9_bash"), ExtResource("10_rush"), ExtResource("11_wall")])
can_block = true
