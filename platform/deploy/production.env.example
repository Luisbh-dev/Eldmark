# Variables of the production compose file (docs/platform.md §12): copy this file to
# production.env, which git ignores, fill it in and use it with "docker compose --env-file
# production.env ..." (header of docker-compose.yml). No secret goes here: each one is a file in
# ELDMARK_SECRETS_DIR (§10.3), and CI fails if an *.example carries the value of one
# (tools/check_secrets.sh).
ELDMARK_ENV=production

# Public API domain (Caddy requests its certificate from Let's Encrypt) and the ACME account email.
ELDMARK_DOMAIN=eldmark.example
ELDMARK_ACME_EMAIL=ops@eldmark.example

# Images (production from a tag, GHCR). Without them, the compose file builds them locally
# (eldmark-*:local); the zones one is from TEC-20.
ELDMARK_PLATFORM_IMAGE=ghcr.io/luisbh-dev/eldmark-platform:v0.5.0
ELDMARK_OPS_IMAGE=ghcr.io/luisbh-dev/eldmark-ops:v0.5.0
ELDMARK_ZONE_IMAGE=ghcr.io/luisbh-dev/eldmark-zone:v0.5.0

# Host that clients connect to over UDP (the zones' --public-address) and the ones a zone's
# registration accepts (ELDMARK_ZONE_HOSTS, comma-separated).
ELDMARK_PUBLIC_HOST=eldmark.example
ELDMARK_ZONE_HOSTS=eldmark.example

# Minimum client protocol (below it, 426): required outside dev and test.
ELDMARK_MIN_PROTOCOL=7

# Sender of the emails (the SMTP provider goes in the smtp_url secret; pending on the user).
ELDMARK_MAIL_FROM=no-reply@eldmark.example

# Open realms and the entry zone of each (§2.3; these are the default values).
ELDMARK_OPEN_REALMS=vardheim,solmarch
ELDMARK_ENTRY_ZONES=vardheim=vado_gris,solmarch=vado_gris

# Folder for the secrets (relative to this directory or absolute) and for the backups on the VPS.
ELDMARK_SECRETS_DIR=./secrets
ELDMARK_BACKUP_HOST_DIR=/var/backups/eldmark-production

# WAL to S3-compatible storage with WAL-G (pitr_check.sh tests the procedure): database image with
# wal-g and its credentials; until it is there, off.
ELDMARK_PG_ARCHIVE_MODE=off
#ELDMARK_DB_IMAGE=ghcr.io/luisbh-dev/eldmark-db-walg:16
#ELDMARK_PG_ARCHIVE_COMMAND=wal-g wal-push %p

# Caddy's network and its fixed IP (the only one the platform reads X-Real-IP from). Change them
# only if they clash with another network on the VPS.
ELDMARK_EDGE_SUBNET=172.30.0.0/24
ELDMARK_CADDY_IP=172.30.0.2
