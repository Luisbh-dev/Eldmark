[ext_resource type="Script" path="res://scripts/shared/combat/attack_definition.gd" id="2_attack"]
[ext_resource type="Resource" path="res://data/combat/sword_light_1.tres" id="3_light1"]
[ext_resource type="Resource" path="res://data/combat/sword_light_2.tres" id="4_light2"]
[ext_resource type="Resource" path="res://data/combat/sword_light_3.tres" id="5_light3"]
[ext_resource type="Resource" path="res://data/combat/sword_heavy.tres" id="6_heavy"]
[ext_resource type="Resource" path="res://data/combat/sword_dodge.tres" id="7_dodge"]
