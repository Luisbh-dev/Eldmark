# Binary policy: every binary is a normal git blob (no Git LFS). Git LFS bandwidth is metered on
# GitHub (10 GiB per month on the free tier) and a public repo would exhaust it after a few dozen
# clones, while regular git traffic has no quota. The largest tracked file is about 8 MB, so keep
# single files well under 50 MB (see CONTRIBUTING.md).
# Note: commits made before this policy used Git LFS, so old history still contains LFS pointers.

# Normalize line endings to LF
* text=auto eol=lf

# 3D models
*.glb binary
*.bin binary
*.fbx binary
*.obj binary
*.blend binary

# Textures and images
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.webp binary
*.exr binary
*.hdr binary
*.psd binary
*.kra binary

# Audio
*.wav binary
*.ogg binary
*.mp3 binary

# Fonts
*.ttf binary
*.otf binary

# Video
*.ogv binary
*.mp4 binary

# Terrain3D region data (the only exception to the text format, see CLAUDE.md)
*.res binary

# Native GDExtension binaries (Terrain3D)
*.dll binary
*.so binary
*.dylib binary
**/*.framework/** binary

# Screenshots shown in the README.
docs/screenshots/** binary

# The website must work from a plain checkout (GitHub Pages serves files as they are), so its
# assets are normal blobs. Keep web/ light: the whole folder is a few MB.
web/assets/** binary
web/assets/**/*.svg text diff eol=lf
web/assets/**/*.txt text diff eol=lf
