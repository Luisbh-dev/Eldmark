# Godot 4
.godot/
/android/

# Builds and exports
/build/
/exports/

# Original asset packs (kept outside the repo, in ../Eldmark-raw)
*.zip
*.7z
*.blend1

# Addon demos
addons/*/demo/

# Local configuration
.env
CLAUDE.local.md

# Operating system
Thumbs.db
desktop.ini
.DS_Store

# Local Godot settings of each machine
override.cfg
.claude/worktrees/

# Temporary copies of the GDExtension libraries that the editor creates on Windows
addons/*/bin/~*

# Local Claude Code settings (permissions of this machine)
.claude/settings.local.json

# Secrets (plataforma.md §10.3): they never go into git; the examples and the test PEMs do
*.env
!*.env.example
platform/deploy/secrets/
*.pem
*.key
!tests/fixtures/**/*.pem

# Platform binary compiled inside platform/
/platform/eldmark-platform
/platform/eldmark-platform.exe

# Python caches (asset tools)
__pycache__/
*.pyc
