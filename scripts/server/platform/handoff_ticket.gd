class_name HandoffTicket
extends RefCounted
## The 52 B entry ticket (docs/platform.md §5.1): identity only, signed by the platform with
## HMAC-SHA256 truncated to 16 B and a key with an identifier. It goes in the HELLO's [code]ticket[/code] field.
## [br][br]
## [codeblock]
## offset  type  field         notes
##  0      u8    version       1
##  1      u8    key_id        key from ELDMARK_TICKET_KEYS (1–255)
##  2      u16   world_id
##  4      u64   ticket_id     random, bit 63 at 0 (in JSON, string)
## 12      u64   character_id  same as HELLO.character_id
## 20      u32   zone_key      zone_key_of(zone id)
## 24      u8    channel
## 25      u8    realm         informational: the claim decides
## 26      u8    arrival       0 = the zone decides; n ≥ 1 = point n − 1 (phase 6)
## 27      u8    flags         bit0 entry from the menu; bit1 handoff (phase 6)
## 28      u32   issued_at     Unix, s
## 32      u32   expires_at    issued_at + 10
## 36      16 B  mac           HMAC-SHA256(key, bytes 0..35), first 16 bytes
## [/codeblock]
## All little-endian. The test vectors are generated by the platform in Go
## ([code]tests/fixtures/tickets/handoff_ticket_vectors.json[/code]) and both sides give the same result. The
## zone's check ([TicketAuthProvider]) uses [method decode], [method verify] and the fields.

const SIZE: int = 52
const VERSION: int = 1
## Signed bytes (everything but the signature).
const SIGNED_SIZE: int = 36
const MAC_SIZE: int = 16
## Bits of [member flags].
const FLAG_FROM_MENU: int = 1 << 0
const FLAG_HANDOFF: int = 1 << 1

var version: int = VERSION
var key_id: int = 0
var world_id: int = 0
var ticket_id: int = 0
var character_id: int = 0
var zone_key: int = 0
var channel: int = 0
var realm: int = 0
var arrival: int = 0
var flags: int = 0
var issued_at: int = 0
var expires_at: int = 0


## The u32 fingerprint of [param zone_id]: the first 4 bytes, as a little-endian u32, of the SHA-256 of the ASCII id.
## It is the ticket's [code]zone_key[/code] and the [code]ref_id[/code] of NPCs and fortresses in the ledger
## (docs/progression.md §5.2). [code]vado_gris[/code] gives 0x19efc013.
static func zone_key_of(zone_id: String) -> int:
	# String.sha256_buffer() hashes the text's UTF-8, which for an ASCII id is the same bytes.
	return zone_id.sha256_buffer().decode_u32(0)


## Reads the fields from [param bytes]; null if they are not 52 B or the version is not 1. It does not check the signature: for that,
## [method verify].
static func decode(bytes: PackedByteArray) -> HandoffTicket:
	if bytes.size() != SIZE or bytes.decode_u8(0) != VERSION:
		return null
	var ticket := HandoffTicket.new()
	ticket.version = bytes.decode_u8(0)
	ticket.key_id = bytes.decode_u8(1)
	ticket.world_id = bytes.decode_u16(2)
	ticket.ticket_id = bytes.decode_u64(4)
	ticket.character_id = bytes.decode_u64(12)
	ticket.zone_key = bytes.decode_u32(20)
	ticket.channel = bytes.decode_u8(24)
	ticket.realm = bytes.decode_u8(25)
	ticket.arrival = bytes.decode_u8(26)
	ticket.flags = bytes.decode_u8(27)
	ticket.issued_at = bytes.decode_u32(28)
	ticket.expires_at = bytes.decode_u32(32)
	return ticket


## true if [param bytes] (the same 52 B this ticket was read from) carry the signature of key
## [member key_id] from [param keys] ([code]{key_id: 32 B or more}[/code]). The signature is compared in constant time.
## An unknown key or bytes of another size, false.
func verify(bytes: PackedByteArray, keys: Dictionary[int, PackedByteArray]) -> bool:
	if bytes.size() != SIZE or not keys.has(key_id) or bytes.decode_u8(1) != key_id:
		return false
	var key: PackedByteArray = keys[key_id]
	if key.is_empty():
		return false
	var expected: PackedByteArray = _mac(key, bytes.slice(0, SIGNED_SIZE))
	if expected.size() != MAC_SIZE:
		return false
	return Crypto.new().constant_time_compare(expected, bytes.slice(SIGNED_SIZE, SIZE))


## The ticket's 52 B signed with [param key] (with whatever [member key_id] it has). For tests and the
## platform fake: in production only the platform signs.
func sign(key: PackedByteArray) -> PackedByteArray:
	var bytes := PackedByteArray()
	bytes.resize(SIGNED_SIZE)
	bytes.encode_u8(0, version & 0xFF)
	bytes.encode_u8(1, key_id & 0xFF)
	bytes.encode_u16(2, world_id & 0xFFFF)
	bytes.encode_u64(4, ticket_id)
	bytes.encode_u64(12, character_id)
	bytes.encode_u32(20, zone_key & 0xFFFFFFFF)
	bytes.encode_u8(24, channel & 0xFF)
	bytes.encode_u8(25, realm & 0xFF)
	bytes.encode_u8(26, arrival & 0xFF)
	bytes.encode_u8(27, flags & 0xFF)
	bytes.encode_u32(28, issued_at & 0xFFFFFFFF)
	bytes.encode_u32(32, expires_at & 0xFFFFFFFF)
	bytes.append_array(_mac(key, bytes))
	return bytes


# HMAC-SHA256(key, data), the first 16 bytes.
static func _mac(key: PackedByteArray, data: PackedByteArray) -> PackedByteArray:
	var context := HMACContext.new()
	if context.start(HashingContext.HASH_SHA256, key) != OK:
		return PackedByteArray()
	context.update(data)
	return context.finish().slice(0, MAC_SIZE)
